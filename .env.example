# Looniva Canva Carousel Agent — environment template.
# Copy to .env and fill in. Do NOT commit .env.

# ── MCP tool prefixes ───────────────────────────────────────────────────
# Default to the friendly aliases declared in .mcp.json. When running inside
# a harness where MCP servers are exposed with UUID-style identifiers, set
# these to the harness-provided prefixes (e.g. mcp__078073c8-5f90-...).
CANVA_MCP_PREFIX=mcp__canva
HIGHSSFIELD_MCP_PREFIX=mcp__highssfield

# ── Canva ───────────────────────────────────────────────────────────────
# Used only when running the orchestrator outside a Claude Code session
# (i.e. via the Claude Agent SDK with a direct MCP server connection).
CANVA_MCP_URL=
CANVA_ACCESS_TOKEN=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ── Higgsfield (a.k.a. highssfield) ─────────────────────────────────────
HIGHSSFIELD_MCP_URL=
HIGHSSFIELD_MCP_AUTH_TOKEN=

# ── Anthropic / Claude Agent SDK ────────────────────────────────────────
# Required only when invoking sub-sessions for skills via the SDK.
ANTHROPIC_API_KEY=

# ── Image staging for Canva upload-asset-from-url ──────────────────────
# Canva MCP upload-asset-from-url needs a public HTTPS URL. The orchestrator
# stages each selected image under this base before issuing the upload call.
# Provide either:
#   1. A base URL + bearer token for a signed-PUT bucket (S3/R2/GCS), OR
#   2. A pre-provisioned HTTPS folder where the agent can PUT files.
TEMP_ASSET_STAGING_URL=
TEMP_ASSET_STAGING_TOKEN=

# ── Output dir ──────────────────────────────────────────────────────────
LOONIVA_OUTPUT_DIR=./outputs/looniva_canva_carousels

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
